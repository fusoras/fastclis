---
import Layout from '@/layouts/Layout.astro'
import FastAlias from '@/components/FastAlias.astro'
import Musuku from '@/components/Musuku.astro'
import SkillsManager from '@/components/SkillsManager.astro'
---

<Layout>
  <h1>FUSORAS</h1>
  <h2>
    CLIs rápidos hechos con Rust que facilitan las cosas: automatiza y acelera
    procesos
  </h2>
  <FastAlias />
  <Musuku />
  <SkillsManager />
</Layout>

<style>
  h1 {
    color: var(--accent);
  }

  h2 {
    text-align: initial;
    font-size: var(--text-md);
    color: color-mix(in srgb, #fff, transparent);
  }
</style>
